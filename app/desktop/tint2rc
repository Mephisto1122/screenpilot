# Screenpilot taskbar: app launchers, open windows, clock. Started by app/workers.py for every worker.
# Clicking a window here brings it to the front (it never minimizes it, so the agent does not lose windows).
rounded = 0
border_width = 0
background_color = #15181e 100
border_color = #000000 0

rounded = 4
border_width = 0
background_color = #2a2f3a 100
border_color = #000000 0

panel_items = LTC
panel_size = 100% 34
panel_margin = 0 0
panel_padding = 6 3 6
panel_position = bottom center horizontal
panel_layer = top
panel_background_id = 1
wm_menu = 1
panel_dock = 0
strut_policy = follow_size

launcher_padding = 4 2 6
launcher_background_id = 0
launcher_icon_size = 24
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/chromium.desktop
launcher_item_app = /usr/share/applications/org.xfce.mousepad.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/libreoffice-writer.desktop
launcher_item_app = /usr/share/applications/libreoffice-calc.desktop

taskbar_mode = single_desktop
taskbar_padding = 4 2 4
taskbar_background_id = 0
taskbar_active_background_id = 0
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 200 30
task_padding = 6 2 6
task_font_color = #c9cfdb 100
task_active_font_color = #ffffff 100
task_background_id = 0
task_active_background_id = 2
task_font = Sans 9

time1_format = %H:%M
time1_font = Sans 9
clock_font_color = #c9cfdb 100
clock_padding = 8 0

tooltip_show_timeout = 0.3
tooltip_hide_timeout = 0.1
mouse_left = toggle
