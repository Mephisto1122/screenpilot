<?xml version="1.0" encoding="UTF-8"?>
<!-- Screenpilot desktop: every normal window opens maximized and focused, so nothing floats over
     another window and the agent always knows where the keyboard goes. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
  </placement>
  <desktops>
    <number>1</number>
  </desktops>
  <applications>
    <application type="normal">
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
  </applications>
</openbox_config>
