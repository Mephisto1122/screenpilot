# Optional cloud planning. Leave empty for local-only operation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local vision model, served by native Ollama on your Mac (Apple GPU).
# run.sh / the dashboard download it into Ollama if it is missing.
# run.sh picks qwen3-vl:8b on Macs with 24 GB or more, qwen3-vl:4b otherwise. Set this to choose yourself.
# OLLAMA_MODEL=qwen3-vl:8b
SCREEN_FPS=12
# Where the container finds Ollama. Default is native Ollama on the host.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_AUTO_PULL=1
